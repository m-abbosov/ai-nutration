# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nutriai?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Encrypts each user's own AI provider API key at rest (BYOK — there is no
# shared server-side AI key). Generate with: openssl rand -hex 32
AI_KEY_ENCRYPTION_SECRET="change-me-to-a-32+-char-random-string"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# Telegram Login Widget (https://core.telegram.org/widgets/login) — create a bot via
# @BotFather, set its domain with /setdomain to the frontend URL below.
TELEGRAM_BOT_TOKEN=

# AI — bring-your-own-key. Users add their own provider key from Settings; these
# vars only pick which model of each provider to call, they hold no credentials.
GEMINI_MODEL="gemini-flash-lite-latest"
OPENAI_MODEL="gpt-4o-mini"
CLAUDE_MODEL="claude-sonnet-4-5"

# CORS / redirects
FRONTEND_URL="http://localhost:5173"
ADMIN_FRONTEND_URL="http://localhost:5174"

# Server
PORT=3001
