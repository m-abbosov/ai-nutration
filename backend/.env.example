# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nutriai?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# Telegram Login Widget (https://core.telegram.org/widgets/login) — create a bot via
# @BotFather, set its domain with /setdomain to the frontend URL below.
TELEGRAM_BOT_TOKEN=

# Gemini (https://aistudio.google.com/apikey) — server-side only, never exposed to the client
GEMINI_API_KEY=
GEMINI_MODEL="gemini-flash-lite-latest"

# CORS / redirects
FRONTEND_URL="http://localhost:5173"

# Server
PORT=3001
