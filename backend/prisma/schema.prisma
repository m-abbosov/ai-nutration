// NutriAI backend — Prisma schema (Phase 1)
// Normalized, minimal-duplication schema. Daily/weekly nutrition totals are computed
// on demand from Meal rows rather than stored redundantly (see DESIGN_MAPPING.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY // x1.2
  LIGHT // x1.375
  MODERATE // x1.55
  ACTIVE // x1.725
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
}

enum MealType {
  BREAKFAST
  LUNCH
  SNACK
  DINNER
}

enum MealSource {
  MANUAL
  AI
}

enum MessageRole {
  USER
  ASSISTANT
}

enum Language {
  UZ
  RU
  EN
}

enum Theme {
  LIGHT
  DARK
}

enum AiProvider {
  GEMINI
  OPENAI
  CLAUDE
  GROQ
}

enum AiKeyStatus {
  OK
  EXHAUSTED
  INVALID
}

// ── Admin panel (Phase 2) ───────────────────────────────────────────────
// Additive only — no existing model/field above this line is touched.
// An "admin user" is a regular User with adminRoleId set; there is no
// separate admin account table (see docs/ADMIN_PANEL.md).

enum AdminRoleName {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
}

enum AdminPermissionKey {
  DASHBOARD_READ
  USERS_READ
  USERS_UPDATE
  USERS_DISABLE
  NUTRITION_READ
  AI_READ
  AI_LOGS_READ
  CONVERSATIONS_READ
  ANALYTICS_READ
  SYSTEM_READ
  ADMIN_USERS_READ
  ADMIN_USERS_MANAGE
  SETTINGS_MANAGE
  AUDIT_LOGS_READ
  USERS_DELETE
  FEATURE_ACCESS_MANAGE
  FITNESS_READ
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model AdminRole {
  id          String        @id @default(cuid())
  name        AdminRoleName @unique
  description String?
  // Seeded built-in roles; the four above are never deletable from the UI.
  isSystem    Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions AdminRolePermission[]
  admins      User[]                @relation("UserAdminRole")

  @@map("admin_roles")
}

model AdminPermission {
  id          String             @id @default(cuid())
  key         AdminPermissionKey @unique
  description String?

  roles AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId String
  role   AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

enum AuditAction {
  ADMIN_LOGIN
  ADMIN_LOGIN_DENIED
  USER_VIEWED
  USER_STATUS_CHANGED
  ADMIN_ROLE_CHANGED
  ADMIN_USER_STATUS_CHANGED
  CONVERSATION_VIEWED
  SETTING_CHANGED
  FEATURE_FLAG_CHANGED
  USER_DELETED
  USER_FEATURE_GRANTED
  USER_FEATURE_REVOKED
}

model AuditLog {
  id      String @id @default(cuid())
  adminId String
  admin   User   @relation("AuditLogsByAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  action     AuditAction
  targetType String? // e.g. "User", "Conversation", "AdminRole", "FeatureFlag"
  targetId   String?
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model FeatureFlag {
  key         String   @id // e.g. "AI_CHAT_ENABLED"
  enabled     Boolean  @default(true)
  description String?
  updatedAt   DateTime @updatedAt

  updatedById String?
  updatedBy   User?   @relation("FeatureFlagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("feature_flags")
}

// Per-user page/feature gating (distinct from FeatureFlag above, which is a
// single app-wide on/off switch). Presence of a row = that user has access
// to that feature; `feature` is a plain string key (e.g. "FITNESS"), not an
// enum, so a new gated feature never needs a migration — see
// common/feature-access/feature-access.constants.ts for the known keys.
model UserFeatureAccess {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  feature   String
  grantedAt DateTime @default(now())

  grantedById String?
  grantedBy   User?   @relation("FeatureAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, feature])
  @@index([feature])
  @@map("user_feature_access")
}

enum AiEndpoint {
  CHAT
  RECOMMENDATION
}

enum AiRequestStatus {
  SUCCESS
  ERROR
}

// One row per provider call attempt from ai.service.ts (both the initial try
// and a schema-validation retry are logged separately). Never stores the
// prompt or the response body — metadata only, privacy-first.
model AiRequestLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation("AiRequestLogsByUser", fields: [userId], references: [id], onDelete: SetNull)

  endpoint AiEndpoint
  provider AiProvider
  model    String

  status      AiRequestStatus
  errorReason String? // ProviderErrorReason | 'GENERATION_FAILED', null when SUCCESS

  responseTimeMs Int

  // Only populated when the provider SDK actually returns usage data in its
  // response (Gemini/OpenAI/Claude all do, when available) — never estimated.
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([endpoint, createdAt])
  @@map("ai_request_logs")
}

// Records every completed calculation on a public /calculators/:slug page,
// for admin-panel analytics (most-used calculator, usage over time). Written
// for anonymous AND signed-in visitors (calculator pages need no auth);
// userId is null for anonymous use. Never blocks the calculator UI — a
// logging failure is swallowed server-side (see calculators.service.ts).
model CalculatorUsageLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation("CalculatorUsageLogsByUser", fields: [userId], references: [id], onDelete: SetNull)

  calculatorId String
  inputs       Json
  result       Json

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([calculatorId, createdAt])
  @@index([userId, createdAt])
  @@map("calculator_usage_logs")
}

// Generic storage for the oidc-provider (MCP OAuth 2.1 authorization server)
// library — one table backs every model kind it defines (Client, Grant,
// Session, AccessToken, AuthorizationCode, RefreshToken, Interaction, ...),
// per its documented adapter interface (payload is model-shape-agnostic on
// our side; oidc-provider owns the shape). See backend/src/mcp-oauth/.
model OidcModel {
  id         String    @id
  name       String
  payload    Json
  grantId    String?
  userCode   String?
  uid        String?
  expiresAt  DateTime?
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([name])
  @@index([name, grantId])
  @@index([name, userCode])
  @@index([name, uid])
  @@index([expiresAt])
  @@map("oidc_models")
}

enum SystemLogSeverity {
  INFO
  WARNING
  ERROR
}

// General API log feed — every 4xx/5xx response (except 401, which is
// routine token-refresh noise) captured from the global exception filter,
// distinct from AiRequestLog, which is domain-specific to provider calls.
// Stack traces are stored but only ever rendered to admins holding
// SYSTEM_READ; never sent to end users. Pruned after 30 days — see
// backend/src/common/system-log-retention.service.ts.
model SystemLog {
  id         String            @id @default(cuid())
  severity   SystemLogSeverity
  service    String // e.g. "api", "database", "ai"
  message    String            @db.Text
  requestId  String?
  statusCode Int?
  stack      String?           @db.Text

  createdAt DateTime @default(now())

  @@index([severity, createdAt])
  @@map("system_logs")
}

model User {
  id         String  @id @default(cuid())
  telegramId String? @unique
  googleId   String? @unique
  email      String? @unique
  name       String
  avatarUrl  String?

  // Onboarding / profile
  age                   Int?
  heightCm              Float?
  weightKg              Float?
  goalWeightKg          Float?
  gender                Gender?
  activityLevel         ActivityLevel?
  goal                  Goal?
  dailyCalorieTarget    Int?
  proteinTargetG        Int?
  carbsTargetG          Int?
  fatTargetG            Int?
  onboardingCompletedAt DateTime?

  // Preferences
  language Language @default(UZ)
  theme    Theme    @default(DARK)

  // Notification preference flags (Phase 1: stored only, no delivery mechanism yet)
  notifyDaily  Boolean @default(true)
  notifyWeekly Boolean @default(true)
  notifyAiTips Boolean @default(false)

  refreshTokenHash String?

  // Per-user AI credentials (BYOK): each user supplies their own provider API
  // key so AI usage is billed to them, not the app's shared quota. The key is
  // encrypted at rest (see ai/crypto.util.ts) — only its provider, last 4
  // characters, and last known health status are ever exposed to the client.
  aiProvider         AiProvider?
  aiApiKeyEncrypted  String?
  aiApiKeyLast4      String?
  aiKeyStatus        AiKeyStatus?
  aiKeyStatusMessage String?

  // Admin panel (Phase 2). A user is "an admin" iff adminRoleId is set;
  // adminActive lets a SUPER_ADMIN revoke panel access without losing the
  // role assignment (re-enabling doesn't require re-picking a role).
  adminRoleId String?
  adminRole   AdminRole? @relation("UserAdminRole", fields: [adminRoleId], references: [id])
  adminActive Boolean    @default(true)
  lastLoginAt DateTime?

  // Regular-app account status, settable by an admin with USERS_DISABLE.
  // Distinct from adminActive above, which only gates admin-panel access.
  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meals         Meal[]
  conversations Conversation[]

  workouts                Workout[]
  personalRecords         PersonalRecord[]
  muscleProgressSnapshots MuscleProgressSnapshot[]

  featureAccess        UserFeatureAccess[]
  grantedFeatureAccess UserFeatureAccess[] @relation("FeatureAccessGrantedBy")

  auditLogs           AuditLog[]           @relation("AuditLogsByAdmin")
  updatedFeatureFlags FeatureFlag[]        @relation("FeatureFlagUpdatedBy")
  aiRequestLogs       AiRequestLog[]       @relation("AiRequestLogsByUser")
  calculatorUsageLogs CalculatorUsageLog[] @relation("CalculatorUsageLogsByUser")

  @@map("users")
}

model Meal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date     DateTime @db.Date // local calendar day the meal belongs to
  mealType MealType
  name     String
  emoji    String?

  calories    Int
  protein     Float
  carbs       Float
  fat         Float
  servingSize String?

  source MealSource @default(MANUAL)

  items MealItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@map("meals")
}

model MealItem {
  id     String @id @default(cuid())
  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  name     String
  quantity String
  calories Int
  protein  Float
  carbs    Float
  fat      Float

  @@map("meal_items")
}

model Conversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String @default("New chat")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role     MessageRole
  content  String      @db.Text
  // Structured AI payload when applicable: { kind: "nutrition_card"|"recommendations"|"meal_edit_suggestion"|"workout_analysis", data: {...} }
  metadata Json?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// ── Fitness Tracker ─────────────────────────────────────────────────────
// Additive only. Raw workout/set data is the source of truth; MuscleProgressSnapshot
// is a derived, disposable cache (recomputed deterministically, never the only copy —
// see progress.service.ts). Display names/labels for muscles and exercises live in
// i18n (packages/shared/src/i18n), never stored here.

enum MuscleCode {
  CHEST
  UPPER_CHEST
  BACK
  LATS
  TRAPS
  SHOULDERS
  FRONT_DELTS
  SIDE_DELTS
  REAR_DELTS
  BICEPS
  TRICEPS
  FOREARMS
  ABS
  OBLIQUES
  GLUTES
  QUADS
  HAMSTRINGS
  CALVES
}

enum MuscleRegion {
  FRONT
  BACK
  BOTH
}

enum ExerciseCategory {
  COMPOUND
  ISOLATION
  CARDIO
  BODYWEIGHT
}

enum MuscleRole {
  PRIMARY
  SECONDARY
}

enum WeightUnit {
  KG
  LB
}

enum WorkoutSource {
  MANUAL
  AI
}

enum PRType {
  MAX_WEIGHT
  MAX_REPS
  MAX_VOLUME
  EST_1RM
}

model MuscleGroup {
  code      MuscleCode   @id
  region    MuscleRegion
  sortOrder Int

  exerciseMuscles   ExerciseMuscle[]
  progressSnapshots MuscleProgressSnapshot[]

  @@map("muscle_groups")
}

model Exercise {
  id            String           @id @default(cuid())
  slug          String           @unique
  category      ExerciseCategory
  primaryMuscle MuscleCode
  equipment     String?
  // Reserved for a future "add your own exercise" feature; always false for
  // catalog-seeded rows in this phase.
  isCustom      Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases          ExerciseAlias[]
  muscles          ExerciseMuscle[]
  workoutExercises WorkoutExercise[]
  personalRecords  PersonalRecord[]

  @@index([primaryMuscle])
  @@map("exercises")
}

// Multi-language synonym lookup for the AI workout parser (exercise-matcher.util.ts).
// A separate table (not a JSON/array field on Exercise) because matching needs an
// indexed exact lookup on (language, normalized), and one exercise has many aliases
// per language ("shoulder press" / "overhead press" / "OHP" in English alone).
model ExerciseAlias {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  language   Language
  alias      String // display form, as a user would type it, e.g. "Yelkaga max"
  normalized String // lowercased/trimmed match key used by the matcher
  // The canonical display name shown in the UI for this (exercise, language) —
  // exactly one alias per (exerciseId, language) should have this set; enforced
  // by seed-exercises.ts, not a DB constraint (Prisma has no partial unique index).
  isPrimary  Boolean  @default(false)

  @@unique([language, normalized])
  @@index([exerciseId])
  @@map("exercise_aliases")
}

model ExerciseMuscle {
  id          String      @id @default(cuid())
  exerciseId  String
  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscle      MuscleCode
  muscleGroup MuscleGroup @relation(fields: [muscle], references: [code])

  role   MuscleRole
  // Volume-attribution weight for muscle-progress scoring (e.g. secondary movers
  // contribute a fraction of the set's volume to their score) — see muscle-score.util.ts.
  weight Float      @default(1.0)

  @@unique([exerciseId, muscle])
  @@index([muscle])
  @@map("exercise_muscles")
}

model Workout {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime  @db.Date // local calendar day the workout belongs to
  startedAt   DateTime?
  endedAt     DateTime?
  durationSec Int?
  notes       String?

  // Denormalized for fast list/dashboard rendering — recomputed from sets on every
  // write (see fitness/workout/lib/volume.util.ts), never hand-edited independently.
  totalVolume       Float @default(0)
  estimatedCalories Int?

  source WorkoutSource @default(MANUAL)

  exercises WorkoutExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@map("workouts")
}

model WorkoutExercise {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  // Restrict, not Cascade: a catalog exercise must never be deletable out from
  // under a user's logged history.
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  order Int

  sets ExerciseSet[]

  @@index([workoutId])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model ExerciseSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  setNumber   Int
  weight      Float?
  weightUnit  WeightUnit @default(KG)
  reps        Int?
  durationSec Int?
  completed   Boolean    @default(true)

  @@index([workoutExerciseId])
  @@map("exercise_sets")
}

// Current best value per (user, exercise, recordType) — one row, upserted on every
// workout save that beats it. History isn't kept here; it's derivable from raw sets.
model PersonalRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  recordType PRType
  value      Float
  weight     Float?
  reps       Int?
  achievedAt DateTime

  updatedAt DateTime @updatedAt

  @@unique([userId, exerciseId, recordType])
  @@index([userId, exerciseId])
  @@map("personal_records")
}

// Cached output of muscle-score.util.ts, keyed per calendar day. A product
// visualization score, not a medical measurement — see progressScore doc comment
// in muscle-score.util.ts. Disposable: deleting a row only means the next
// GET /fitness/progress recomputes it from raw workout/set data.
model MuscleProgressSnapshot {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  muscle      MuscleCode
  muscleGroup MuscleGroup @relation(fields: [muscle], references: [code])

  snapshotDate  DateTime  @db.Date
  progressScore Int
  weeklySets    Int
  weeklyVolume  Float
  sessionsCount Int
  lastTrainedAt DateTime?

  computedAt DateTime @default(now())

  @@unique([userId, muscle, snapshotDate])
  @@index([userId, snapshotDate])
  @@map("muscle_progress_snapshots")
}
