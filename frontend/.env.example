# Base URL of the NestJS API. Never put secrets in this file — everything here ships to the browser.
VITE_API_URL="http://localhost:3001/api"

# Public Google OAuth client ID is not needed client-side (the backend drives the OAuth
# redirect flow), kept unset intentionally. If a future phase adds Google Identity
# Services (client-side one-tap), add VITE_GOOGLE_CLIENT_ID here — it is safe to expose
# (client IDs are public by design), but GOOGLE_CLIENT_SECRET must never appear in this file.

# Telegram bot username, used to render the Telegram Login Widget script tag.
VITE_TELEGRAM_BOT_USERNAME=
